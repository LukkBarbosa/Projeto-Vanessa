<%- include('partials/header') %>

<section>
  <h2>Editar Produto</h2>
  <form action="/produtos/<%= produto.id %>?_method=PUT" method="POST" class="form">
    <label>Nome do Produto
      <input type="text" name="nome" value="<%= produto.nome %>" required>
    </label>

    <label>Valor (R$)
      <input type="number" step="0.01" name="valor" value="<%= produto.valor %>" required>
    </label>

    <label>Descrição
      <textarea name="descricao" rows="3" required><%= produto.descricao %></textarea>
    </label>

    <label>Fornecedor
      <input type="text" name="fornecedor" value="<%= produto.fornecedor %>" required>
    </label>

    <label>E-mail do Fornecedor
      <input type="email" name="email" value="<%= produto.email %>" required>
    </label>

    <label>Telefone do Fornecedor
      <input type="tel" name="telefone" value="<%= produto.telefone %>" required>
    </label>

    <div class="acoes">
      <button type="submit" class="btn">Salvar Alterações</button>
      <a href="/produtos" class="btn btn-secundario">Cancelar</a>
    </div>
  </form>

  <hr>

  <form action="/produtos/<%= produto.id %>?_method=DELETE" method="POST">
    <button type="submit" class="btn btn-apagar"
            onclick="return confirm('Deseja realmente apagar este produto?')">
      Apagar Produto
    </button>
  </form>
</section>

<%- include('partials/footer') %>
